# Dependencias
node_modules/
apps/node_modules/
apps/*/node_modules/

# Builds locales
# dist-embed NO se ignora porque Physikos lo necesita en GitHub Pages
apps/*/dist/
apps/*/.vite/

# Cachés de TypeScript
apps/*/*.tsbuildinfo
apps/*/tsconfig*.tsbuildinfo

# Cobertura y cachés generales
coverage/
**/coverage/
.cache/
**/.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variables locales y archivos sensibles
.env
.env.*
!.env.example
*.local

# Lockfiles internos de aplicaciones
# El lockfile principal será apps/package-lock.json
apps/*/package-lock.json

# Mapas generados opcionales
apps/*/dist-embed/**/*.map

# Archivos temporales
*.tmp
*.temp
*.bak
*.swp

# Editores
.vscode/
.idea/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Herramientas locales
.codex/
.agents/